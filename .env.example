# Copy this file to ".env" (same folder as run.py) and fill in what you need.
#
# .env is gitignored. Do not commit a real key, password or access code.

# --- Data pipeline -----------------------------------------------------------
#
# Get a key instantly and free at https://open.fda.gov/apis/authentication/
# It raises the limit from 1,000 requests/day to 120,000, and the count-bucket
# cap from 100 to 1,000.

OPENFDA_API_KEY=paste-your-key-here

# --- Server ------------------------------------------------------------------
#
# Signs session cookies. Required for any deployment that is not behind the
# access gate; serve.py refuses to start without it. Generate with
#   python scripts/make_secret_key.py

RXSIGNAL_SECRET_KEY=

# Set to 1 wherever TLS terminates, so the session cookie is never sent in
# clear. Leave empty for local HTTP.
RXSIGNAL_COOKIE_SECURE=

# Site-wide access gate for a closed review. Generate with
#   python scripts/make_access_code.py
RXSIGNAL_ACCESS_CODE_HASH=

# Requests per minute per IP.
RXSIGNAL_RATE_LIMIT=60

# Opens /admin/analytics?admin_code=... Aggregates only. Unset means the page
# does not exist, which is the correct default.
RXSIGNAL_ADMIN_CODE=

# --- Accounts ----------------------------------------------------------------
#
# Default is a SQLite file under data/. A Postgres URL works unchanged:
#   postgresql+psycopg://user:password@host:5432/rxsignal

DATABASE_URL=sqlite:///data/rxsignal.db

# --- Email -------------------------------------------------------------------
#
# With SMTP_HOST unset, messages are written to data/outbox/ as .eml files
# instead of being sent. Development needs no mail server, and nothing is
# silently dropped.
#
# APP_BASE_URL must be the address testers actually use: it is what the
# verification and password-reset links point at.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=rxsignal@example.com
SMTP_USE_TLS=true
APP_BASE_URL=http://localhost:8000
