# Secrets -- never commit a real API key
.env

# Cached API responses and intermediate tables: large, rebuildable, and not
# needed to serve.
data/raw/
data/flat/
data/results/*

# The scored table IS committed. The Dockerfile copies it into the image and
# the host builds from this repository, so ignoring it means the build fails at
# that COPY with a path that plainly exists on the developer's machine. ~17 MB,
# well inside Git's comfortable range.
!data/results/scored_pairs.parquet

# Also committed, and for the same reason: the worksheet loads it at import and
# the image builds from this repository. 2.5 MB. The 4.8 MB of raw label prose
# it is derived from stays out -- data/raw/ is ignored above.
!data/results/label_interaction_pairs.json
!data/results/drug_facts.json

# Any SQLite database and its WAL/SHM sidecars. Globbed rather than named:
# the accounts store holds real user data, and the sidecars from a throwaway
# test database were picked up by an exact-name rule that did not match them.
*.db
*.db-wal
*.db-shm

# Mail written to disk when no SMTP server is configured; contains addresses
data/outbox/

# CA bundle exported from the Windows trust store at runtime
winca.pem

__pycache__/
*.pyc
